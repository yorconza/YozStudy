<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.StudyPlacesActivity">

    <!-- Main Container (Simulating map background and top bar) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#E8ECE9">

        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#3F51B5"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/study_places"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPlacesCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="4 saved places"
                android:textColor="#E0E0E0"
                android:textSize="14sp" />

            <!-- Places search bar -->
            <EditText
                android:id="@+id/etSearchPlace"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_rounded_input"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="8dp"
                android:hint="@string/action_search_place"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Map View (Your MapView or Google Maps Fragment goes here) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Decorative background simulating the map grid -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#E2E8E4" />

        </FrameLayout>
    </LinearLayout>

    <!-- Floating bottom card with selected place details -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Place name -->
            <TextView
                android:id="@+id/tvPlaceNameCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Central Library"
                android:textColor="#222222"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Rating and completed blocks -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Simulated stars -->
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_star"
                    app:tint="#FFC107" />

                <TextView
                    android:id="@+id/tvScoreCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    tools:text="4.5"
                    android:textColor="#222222"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvBlocksCountCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    tools:text="· 12 blocks"
                    android:textColor="#666666"
                    android:textSize="14sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="#EEEEEE" />

            <!-- Indicator 1: Silence -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="@string/rating_silence"
                    android:textColor="#555555"
                    android:textSize="14sp" />

                <ProgressBar
                    android:id="@+id/pbSilence"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progress="80"
                    android:progressDrawable="@drawable/bg_progress_custom" />
            </LinearLayout>

            <!-- Indicator 2: Wifi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="@string/rating_wifi"
                    android:textColor="#555555"
                    android:textSize="14sp" />

                <ProgressBar
                    android:id="@+id/pbWifi"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progress="70"
                    android:progressDrawable="@drawable/bg_progress_custom" />
            </LinearLayout>

            <!-- Indicator 3: Comfort -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="@string/rating_comfort"
                    android:textColor="#555555"
                    android:textSize="14sp" />

                <ProgressBar
                    android:id="@+id/pbComfort"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progress="65"
                    android:progressDrawable="@drawable/bg_progress_custom" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>